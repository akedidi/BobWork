{
  "name": "bob-work-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter macos run dev:tauri",
    "build": "pnpm --filter macos run build:tauri",
    "mac:dev": "pnpm --filter macos run dev:tauri",
    "mac:build": "pnpm --filter macos run build:tauri",
    "mac:dmg": "pnpm --filter macos run build:tauri --bundles dmg",
    "mac:test:rust": "cargo test --manifest-path apps/macos/src-tauri/Cargo.toml --locked -- --test-threads=1",
    "mac:test:ts": "pnpm --filter macos run test",
    "mac:test:e2e": "pnpm --filter macos run test:e2e",
    "mac:test:live-bob-oauth": "pnpm --filter macos run test:e2e:live-bob-oauth",
    "mac:smoke:bob": "bash apps/macos/scripts/smoke-bob-shell.sh",
    "security:audit:js": "pnpm audit --audit-level=high --ignore CVE-2026-56876",
    "security:audit:rust": "cargo audit --file apps/macos/src-tauri/Cargo.lock",
    "security:audit": "pnpm security:audit:js && pnpm security:audit:rust",
    "mac:test": "pnpm mac:test:rust && pnpm mac:test:ts",
    "mac:verify": "pnpm --filter macos run verify",
    "mac:ci": "pnpm mac:verify && pnpm mac:test:rust && cargo build --release --manifest-path apps/macos/src-tauri/Cargo.toml --locked",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm mac:test:ts"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
