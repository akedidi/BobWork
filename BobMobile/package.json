{
  "name": "bob-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "mock": "node scripts/mock-server.mjs",
    "ios": "expo run:ios",
    "ios:release:prepare": "bash scripts/release-ios.sh prepare",
    "ios:release:simulator": "bash scripts/release-ios.sh simulator",
    "ios:release:archive": "bash scripts/release-ios.sh archive",
    "ios:release:verify": "bash scripts/release-ios.sh verify",
    "android": "expo run:android",
    "web": "expo start --web",
    "test:markdown": "node --experimental-strip-types --test src/markdown.test.mjs",
    "test:i18n": "node --experimental-strip-types --test src/i18n.test.mjs",
    "test:visualization": "node --experimental-strip-types --test src/visualizationSizing.test.mjs src/visualizationHtml.test.mjs",
    "test:maps": "node --experimental-strip-types --test src/mapSpec.test.mjs",
    "typecheck": "tsc --noEmit",
    "doctor": "npx --yes expo-doctor"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.8",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.18",
    "expo-asset": "~57.0.15",
    "expo-audio": "~57.0.4",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.16",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.2",
    "expo-image-picker": "~57.0.14",
    "expo-location": "~57.0.16",
    "expo-notifications": "~57.0.15",
    "expo-secure-store": "~57.0.2",
    "expo-sharing": "~57.0.16",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-marked": "^8.1.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
