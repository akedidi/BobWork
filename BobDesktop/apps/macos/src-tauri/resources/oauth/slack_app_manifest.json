{
  "display_information": {
    "name": "Bob Work",
    "description": "Bob Work Slack connector (OAuth PKCE).",
    "background_color": "#1B1B1F"
  },
  "oauth_config": {
    "redirect_urls": [
      "http://127.0.0.1:47823/oauth/callback"
    ],
    "scopes": {
      "user": [
        "channels:history",
        "channels:read",
        "chat:write",
        "files:read",
        "groups:history",
        "groups:read",
        "im:history",
        "im:read",
        "mpim:history",
        "mpim:read",
        "search:read",
        "users:read"
      ]
    },
    "pkce_enabled": true
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
