#!/bin/sh
set -eu

command_name="${1:-}"

if [ "$command_name" = "--version" ]; then
  printf '%s\n' '2.0.0' 'commit: e2e-fixture'
  exit 0
fi

if [ "$command_name" = "--help" ]; then
  printf '%s\n' \
    'Usage: bob [options] [command]' \
    '--resume [task-id]' \
    '--list-tasks' \
    'Commands: chat run mcp'
  exit 0
fi

if [ "$command_name" = "run" ] && [ "${2:-}" = "--help" ]; then
  printf '%s\n' \
    'Usage: bob run [options] [prompt...]' \
    'Execute a single task in headless mode' \
    '--format <pretty|json|stream-json>' \
    '--workspace <path>' \
    '--mode <mode>' \
    '--max-cost <number>' \
    '--max-turns <number>' \
    '--log-level <debug|info|warn|error|silent>' \
    '--disable-mcp' \
    '--disable-subagents' \
    '--trust' \
    '--resume [task-id]'
  exit 0
fi

if [ "$command_name" = "chat" ] && [ "${2:-}" = "--help" ]; then
  printf '%s\n' 'Usage: bob chat [options]' '--auto-approve' '--disable-subagents' '--log-level <level>'
  exit 0
fi

if [ "$command_name" = "mcp" ] && [ "${2:-}" = "--help" ]; then
  printf '%s\n' 'Usage: bob mcp [command]' 'add add-json remove list enable disable'
  exit 0
fi

if [ "$command_name" = "chat" ]; then
  mkdir -p "$HOME/.bob/settings"
  printf '%s\n' '{"bob.auth.tokens-https://api.test.bob.ibm.com":"e2e-session-marker"}' > "$HOME/.bob/settings/auth-secrets.json"
  printf '%s\n' 'Complete sign-in in your browser…' 'Logged in as e2e@ibm.com.'
  exit 0
fi

if [ "$command_name" = "mcp" ]; then
  action="${2:-}"
  name="${3:-}"
  mkdir -p "$HOME/.bob/settings"
  config="$HOME/.bob/settings/mcp.json"
  mcp_python() {
    python3 - "$@"
  }
  if [ "$action" = "add-json" ]; then
    definition="${4:-}"
    if [ -z "$definition" ]; then
      definition='{}'
    fi
    mcp_python "$config" "$name" "$definition" <<'PY'
import json
import os
import sys

path, name, definition = sys.argv[1:4]
servers = {}
if os.path.exists(path):
    with open(path, encoding="utf-8") as source:
        data = json.load(source)
        servers = data.get("mcpServers", {})
servers[name] = json.loads(definition)
with open(path, "w", encoding="utf-8") as destination:
    json.dump({"mcpServers": servers}, destination, ensure_ascii=False)
PY
    exit 0
  fi
  if [ "$action" = "remove" ]; then
    mcp_python "$config" "$name" <<'PY'
import json
import os
import sys

path, name = sys.argv[1:3]
if not os.path.exists(path):
    sys.exit(0)
with open(path, encoding="utf-8") as source:
    data = json.load(source)
servers = data.get("mcpServers", {})
servers.pop(name, None)
with open(path, "w", encoding="utf-8") as destination:
    json.dump({"mcpServers": servers}, destination, ensure_ascii=False)
PY
    exit 0
  fi
  if [ "$action" = "disable" ]; then
    mcp_python "$config" "$name" "true" <<'PY'
import json
import os
import sys

path, name, disabled = sys.argv[1:4]
if not os.path.exists(path):
    sys.exit(0)
with open(path, encoding="utf-8") as source:
    data = json.load(source)
servers = data.get("mcpServers", {})
if name in servers and isinstance(servers[name], dict):
    servers[name]["disabled"] = disabled == "true"
with open(path, "w", encoding="utf-8") as destination:
    json.dump({"mcpServers": servers}, destination, ensure_ascii=False)
PY
    exit 0
  fi
  if [ "$action" = "enable" ]; then
    mcp_python "$config" "$name" "false" <<'PY'
import json
import os
import sys

path, name, disabled = sys.argv[1:4]
if not os.path.exists(path):
    sys.exit(0)
with open(path, encoding="utf-8") as source:
    data = json.load(source)
servers = data.get("mcpServers", {})
if name in servers and isinstance(servers[name], dict):
    servers[name]["disabled"] = disabled == "true"
with open(path, "w", encoding="utf-8") as destination:
    json.dump({"mcpServers": servers}, destination, ensure_ascii=False)
PY
    exit 0
  fi
fi

if [ "$command_name" = "run" ]; then
  ensure_skill_dir() {
    skill_dir="$1"
    if [ ! -f "$skill_dir/SKILL.md" ]; then
      mkdir -p "$skill_dir"
      skill_name=$(basename "$skill_dir")
      printf '%s\n' '---' "name: $skill_name" 'description: Skill E2E' 'user-invocable: true' '---' > "$skill_dir/SKILL.md"
    fi
  }

  emit_builtin_plugin_stream() {
    plugin_label="$1"
    tool_file="$2"
    success_message="$3"
    task_id="$4"
    printf '%s\n' "{\"type\":\"message\",\"timestamp\":\"2026-08-08T12:30:00Z\",\"role\":\"assistant\",\"isReasoning\":true,\"content\":\"Chargement du plugin $plugin_label intégré.\"}"
    printf '%s\n' "{\"type\":\"tool_use\",\"timestamp\":\"2026-08-08T12:30:01Z\",\"tool_name\":\"read_file\",\"tool_id\":\"plugin-read\",\"parameters\":{\"path\":\"$tool_file\"}}"
    printf '%s\n' '{"type":"tool_result","timestamp":"2026-08-08T12:30:02Z","tool_id":"plugin-read","status":"success","output":"Structure inspectée"}'
    printf '%s\n' "{\"type\":\"message\",\"timestamp\":\"2026-08-08T12:30:03Z\",\"role\":\"assistant\",\"isReasoning\":false,\"content\":\"$success_message\"}"
    printf '%s\n' "{\"type\":\"result\",\"timestamp\":\"2026-08-08T12:30:04Z\",\"status\":\"success\",\"stats\":{\"task_id\":\"$task_id\",\"duration_ms\":350,\"tool_calls\":1}}"
  }

  call_integration_mcp() {
    server_name="$1"
    script_name="$2"
    env_var="$3"
    token="$4"
    tool_name="$5"
    expected="$6"
    test -f "$HOME/.bob/settings/mcp.json" || {
      printf '%s\n' 'Aucun serveur MCP configuré.' >&2
      exit 9
    }
    grep -q "$server_name" "$HOME/.bob/settings/mcp.json" || {
      printf '%s\n' "Le serveur MCP $server_name est absent de la configuration Bob." >&2
      exit 9
    }
    bundle_dir="$HOME/.bob/resources/integrations"
    script="$bundle_dir/$script_name"
    test -f "$script" || {
      printf '%s\n' "Script MCP $script_name introuvable dans $bundle_dir." >&2
      exit 9
    }
    result=$(printf '%s\n' \
      '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"bob-work-e2e","version":"1"}}}' \
      "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"name\":\"$tool_name\",\"arguments\":{}}}" \
      | env "$env_var=$token" python3 "$script")
    printf '%s' "$result" | grep -q "$expected" || {
      printf '%s\n' "Réponse MCP inattendue pour $server_name/$tool_name." >&2
      exit 9
    }
  }

  # Bob Shell 2 reads non-TTY stdin to EOF before it starts the task, even
  # when a positional prompt is present. This catches regressions where Bob
  # Work leaves a writable stdin pipe open for the whole session.
  stdin_prompt=$(cat)

  if [ -n "${BOB_API_KEY:-}" ] || [ -n "${BOBSHELL_API_KEY:-}" ]; then
    if [ "${BOB_API_KEY:-}" != "${BOBSHELL_API_KEY:-}" ]; then
      printf '%s\n' 'Les variables API Bob reçues par le processus enfant diffèrent.' >&2
      exit 3
    fi
  fi
  prompt=''
  for argument in "$@"; do
    prompt="$argument"
  done
  if [ -n "$stdin_prompt" ]; then
    prompt="$prompt
$stdin_prompt"
  fi

  if printf '%s' "$prompt" | grep -q 'SESSION_SECRET_E2E'; then
    if [ "${BOB_API_KEY:-}" != 'e2e-session-secret' ] || [ "${BOBSHELL_API_KEY:-}" != 'e2e-session-secret' ]; then
      printf '%s\n' 'La clé de session n’a pas été injectée uniquement au processus Bob.' >&2
      exit 4
    fi
  fi

  if printf '%s' "$prompt" | grep -q 'BOB_WORK_CONVERSATION_TITLE'; then
    if printf '%s' "$prompt" | grep -q 'PREMIER_PROMPT_VISIBLE_E2E'; then
      generated_title='Affichage immédiat du premier prompt'
    elif printf '%s' "$prompt" | grep -q 'PREMIER_PROMPT_E2E'; then
      generated_title='Analyse du budget alpha'
    elif printf '%s' "$prompt" | grep -q 'SECOND_PROMPT_E2E'; then
      generated_title='Titre incorrect du second prompt'
    else
      generated_title='Conversation générée par Bob'
    fi
    sleep 1
    printf '%s\n' "{\"type\":\"message\",\"timestamp\":\"2026-08-08T11:59:59Z\",\"role\":\"assistant\",\"isReasoning\":false,\"content\":\"$generated_title\"}"
    printf '%s\n' '{"type":"result","timestamp":"2026-08-08T12:00:00Z","status":"success","stats":{"task_id":"e2e-title","duration_ms":50,"tool_calls":0}}'
    exit 0
  fi

  if printf '%s' "$prompt" | grep -q 'USE_BUILTIN_WORD_PLUGIN_E2E'; then
    if ! printf '%s' "$prompt" | grep -q '\$bob-work-microsoft-word'; then
      printf '%s\n' 'Le plugin Word intégré n’a pas été traduit en skill Bob.' >&2
      exit 6
    fi
    ensure_skill_dir "$HOME/.bob/skills/bob-work-microsoft-word"
    emit_builtin_plugin_stream 'Microsoft Word' 'draft.docx' 'Plugin Microsoft Word utilisé : le brouillon DOCX a été analysé et est prêt pour modification.' 'e2e-builtin-word'
    exit 0
  fi

  if printf '%s' "$prompt" | grep -q 'USE_SKILL_E2E'; then
    if ! printf '%s' "$prompt" | grep -q '\$skill-e2e-local'; then
      printf '%s\n' 'Le skill personnel n’a pas été traduit pour Bob Shell.' >&2
      exit 7
    fi
    test -f "$HOME/.bob/skills/skill-e2e-local/SKILL.md" || {
      printf '%s\n' 'Le skill skill-e2e-local est absent du workspace Bob.' >&2
      exit 7
    }
    printf '%s\n' '{"type":"message","timestamp":"2026-08-08T12:31:00Z","role":"assistant","isReasoning":true,"content":"Chargement du skill personnel skill-e2e-local."}'
    printf '%s\n' '{"type":"tool_use","timestamp":"2026-08-08T12:31:01Z","tool_name":"read_file","tool_id":"skill-read","parameters":{"path":"~/.bob/skills/skill-e2e-local/SKILL.md"}}'
    printf '%s\n' '{"type":"tool_result","timestamp":"2026-08-08T12:31:02Z","tool_id":"skill-read","status":"success","output":"Instructions skill E2E chargées"}'
    printf '%s\n' '{"type":"message","timestamp":"2026-08-08T12:31:03Z","role":"assistant","isReasoning":false,"content":"Skill skill-e2e-local exécuté : synthèse locale produite à partir des instructions E2E."}'
    printf '%s\n' '{"type":"result","timestamp":"2026-08-08T12:31:04Z","status":"success","stats":{"task_id":"e2e-skill-use","duration_ms":250,"tool_calls":1}}'
    exit 0
  fi

  if printf '%s' "$prompt" | grep -q 'GITHUB_INTEGRATION_E2E'; then
    if [ "${GH_TOKEN:-}" != 'e2e-github-token' ] && [ "${GITHUB_TOKEN:-}" != 'e2e-github-token' ]; then
      printf '%s\n' 'Le jeton GitHub de session n’a pas été injecté dans le processus Bob.' >&2
      exit 8
    fi
    if ! printf '%s' "$prompt" | grep -q '\$bob-work-github'; then
      printf '%s\n' 'Le skill GitHub intégré n’a pas été invoqué.' >&2
      exit 8
    fi
    test -f "$HOME/.bob/skills/bob-work-github/SKILL.md" || {
      printf '%s\n' 'Le skill bob-work-github n’a pas été installé après connexion.' >&2
      exit 8
    }
    printf '%s\n' '{"type":"message","timestamp":"2026-08-08T12:32:00Z","role":"assistant","isReasoning":true,"content":"Consultation GitHub via le jeton de session autorisé."}'
    printf '%s\n' '{"type":"tool_use","timestamp":"2026-08-08T12:32:01Z","tool_name":"execute_command","tool_id":"gh-repo-list","parameters":{"command":"gh repo list --limit 3"}}'
    printf '%s\n' '{"type":"tool_result","timestamp":"2026-08-08T12:32:02Z","tool_id":"gh-repo-list","status":"success","output":"bob-work/demo\\nbob-work/plugins"}'
    printf '%s\n' '{"type":"message","timestamp":"2026-08-08T12:32:03Z","role":"assistant","isReasoning":false,"content":"Intégration GitHub active : deux dépôts consultés en lecture seule via gh CLI."}'
    printf '%s\n' '{"type":"result","timestamp":"2026-08-08T12:32:04Z","status":"success","stats":{"task_id":"e2e-github-integration","duration_ms":300,"tool_calls":1}}'
    exit 0
  fi

  if printf '%s' "$prompt" | grep -q 'USE_BUILTIN_DOCUMENTS_PLUGIN_E2E'; then
    if ! printf '%s' "$prompt" | grep -q '\$bob-work-documents'; then
      printf '%s\n' 'Le plugin Documents intégré n’a pas été traduit en skill Bob.' >&2
      exit 6
    fi
    ensure_skill_dir "$HOME/.bob/skills/bob-work-documents"
    emit_builtin_plugin_stream 'Documents' 'notes.md' 'Plugin Documents utilisé : le brouillon Markdown local a été préparé.' 'e2e-builtin-documents'
    exit 0
  fi

  if printf '%s' "$prompt" | grep -q 'USE_BUILTIN_EXCEL_PLUGIN_E2E'; then
    if ! printf '%s' "$prompt" | grep -q '\$bob-work-microsoft-excel'; then
      printf '%s\n' 'Le plugin Excel intégré n’a pas été traduit en skill Bob.' >&2
      exit 6
    fi
    ensure_skill_dir "$HOME/.bob/skills/bob-work-microsoft-excel"
    emit_builtin_plugin_stream 'Microsoft Excel' 'workbook.xlsx' 'Plugin Microsoft Excel utilisé : le classeur XLSX a été analysé et les formules sont intactes.' 'e2e-builtin-excel'
    exit 0
  fi

  if printf '%s' "$prompt" | grep -q 'USE_BUILTIN_POWERPOINT_PLUGIN_E2E'; then
    if ! printf '%s' "$prompt" | grep -q '\$bob-work-microsoft-powerpoint'; then
      printf '%s\n' 'Le plugin PowerPoint intégré n’a pas été traduit en skill Bob.' >&2
      exit 6
    fi
    ensure_skill_dir "$HOME/.bob/skills/bob-work-microsoft-powerpoint"
    emit_builtin_plugin_stream 'Microsoft PowerPoint' 'deck.pptx' 'Plugin Microsoft PowerPoint utilisé : la présentation PPTX contient 4 slides cohérentes.' 'e2e-builtin-powerpoint'
    exit 0
  fi

  if printf '%s' "$prompt" | grep -q 'USE_BUILTIN_ONENOTE_PLUGIN_E2E'; then
    if ! printf '%s' "$prompt" | grep -q '\$bob-work-microsoft-onenote'; then
      printf '%s\n' 'Le plugin OneNote intégré n’a pas été traduit en skill Bob.' >&2
      exit 6
    fi
    if [ "${MICROSOFT_GRAPH_ACCESS_TOKEN:-}" != 'e2e-microsoft-token' ]; then
      printf '%s\n' 'Le jeton Microsoft Graph n’a pas été injecté pour OneNote.' >&2
      exit 10
    fi
    ensure_skill_dir "$HOME/.bob/skills/bob-work-microsoft-onenote"
    emit_builtin_plugin_stream 'Microsoft OneNote' 'page-one.onenote' 'Plugin Microsoft OneNote utilisé : brouillon de page préparé en attendant la publication Graph.' 'e2e-builtin-onenote'
    exit 0
  fi

  if printf '%s' "$prompt" | grep -q 'SLACK_INTEGRATION_E2E'; then
    if [ "${SLACK_BOT_TOKEN:-}" != 'e2e-slack-token' ]; then
      printf '%s\n' 'Le jeton Slack n’a pas été injecté dans le processus Bob.' >&2
      exit 8
    fi
    if ! printf '%s' "$prompt" | grep -q '\$bob-work-slack'; then
      printf '%s\n' 'Le skill Slack intégré n’a pas été invoqué.' >&2
      exit 8
    fi
    ensure_skill_dir "$HOME/.bob/skills/bob-work-slack"
    printf '%s\n' '{"type":"message","timestamp":"2026-08-08T12:34:00Z","role":"assistant","isReasoning":true,"content":"Connexion Slack via le jeton autorisé."}'
    printf '%s\n' '{"type":"tool_use","timestamp":"2026-08-08T12:34:01Z","tool_name":"execute_command","tool_id":"slack-search","parameters":{"command":"slack search messages"}}'
    printf '%s\n' '{"type":"tool_result","timestamp":"2026-08-08T12:34:02Z","tool_id":"slack-search","status":"success","output":"3 messages trouvés"}'
    printf '%s\n' '{"type":"message","timestamp":"2026-08-08T12:34:03Z","role":"assistant","isReasoning":false,"content":"Intégration Slack active : 3 messages consultés dans le canal autorisé."}'
    printf '%s\n' '{"type":"result","timestamp":"2026-08-08T12:34:04Z","status":"success","stats":{"task_id":"e2e-slack-integration","duration_ms":280,"tool_calls":1}}'
    exit 0
  fi

  if printf '%s' "$prompt" | grep -q 'MONDAY_INTEGRATION_E2E'; then
    if [ "${MONDAY_API_TOKEN:-}" != 'e2e-monday-token' ]; then
      printf '%s\n' 'Le jeton Monday.com n’a pas été injecté dans le processus Bob.' >&2
      exit 8
    fi
    if ! printf '%s' "$prompt" | grep -q '\$bob-work-monday'; then
      printf '%s\n' 'Le skill Monday intégré n’a pas été invoqué.' >&2
      exit 8
    fi
    ensure_skill_dir "$HOME/.bob/skills/bob-work-monday"
    printf '%s\n' '{"type":"message","timestamp":"2026-08-08T12:35:00Z","role":"assistant","isReasoning":true,"content":"Interrogation Monday.com via GraphQL."}'
    printf '%s\n' '{"type":"tool_use","timestamp":"2026-08-08T12:35:01Z","tool_name":"execute_command","tool_id":"monday-boards","parameters":{"command":"monday boards list"}}'
    printf '%s\n' '{"type":"tool_result","timestamp":"2026-08-08T12:35:02Z","tool_id":"monday-boards","status":"success","output":"Roadmap Q3\\nBacklog produit"}'
    printf '%s\n' '{"type":"message","timestamp":"2026-08-08T12:35:03Z","role":"assistant","isReasoning":false,"content":"Intégration Monday.com active : 2 tableaux consultés."}'
    printf '%s\n' '{"type":"result","timestamp":"2026-08-08T12:35:04Z","status":"success","stats":{"task_id":"e2e-monday-integration","duration_ms":260,"tool_calls":1}}'
    exit 0
  fi

  if printf '%s' "$prompt" | grep -q 'MICROSOFT_INTEGRATION_E2E'; then
    if [ "${MICROSOFT_GRAPH_ACCESS_TOKEN:-}" != 'e2e-microsoft-token' ]; then
      printf '%s\n' 'Le jeton Microsoft Graph n’a pas été injecté dans le processus Bob.' >&2
      exit 8
    fi
    if ! printf '%s' "$prompt" | grep -q '\$bob-work-outlook-mail'; then
      printf '%s\n' 'Le skill Outlook intégré n’a pas été invoqué.' >&2
      exit 8
    fi
    ensure_skill_dir "$HOME/.bob/skills/bob-work-outlook-mail"
    printf '%s\n' '{"type":"message","timestamp":"2026-08-08T12:36:00Z","role":"assistant","isReasoning":true,"content":"Consultation Outlook via Microsoft Graph."}'
    printf '%s\n' '{"type":"tool_use","timestamp":"2026-08-08T12:36:01Z","tool_name":"execute_command","tool_id":"graph-mail","parameters":{"command":"graph mail search"}}'
    printf '%s\n' '{"type":"tool_result","timestamp":"2026-08-08T12:36:02Z","tool_id":"graph-mail","status":"success","output":"2 messages récents"}'
    printf '%s\n' '{"type":"message","timestamp":"2026-08-08T12:36:03Z","role":"assistant","isReasoning":false,"content":"Intégration Microsoft Outlook active : 2 messages récents consultés via Graph."}'
    printf '%s\n' '{"type":"result","timestamp":"2026-08-08T12:36:04Z","status":"success","stats":{"task_id":"e2e-microsoft-integration","duration_ms":290,"tool_calls":1}}'
    exit 0
  fi

  if printf '%s' "$prompt" | grep -q 'USE_GITHUB_CONNECTOR_MCP_E2E'; then
    call_integration_mcp 'bob-work-github' 'github_server.py' 'GITHUB_TOKEN' 'e2e-github-token' 'github_list_repos' 'bob-work/demo'
    printf '%s\n' '{"type":"message","timestamp":"2026-08-08T12:38:00Z","role":"assistant","isReasoning":true,"content":"Initialisation du connecteur MCP GitHub."}'
    printf '%s\n' '{"type":"tool_use","timestamp":"2026-08-08T12:38:01Z","tool_name":"use_mcp_tool","tool_id":"github-repos","parameters":{"server":"bob-work-github","tool":"github_list_repos","arguments":{"limit":2}}}'
    printf '%s\n' '{"type":"tool_result","timestamp":"2026-08-08T12:38:02Z","tool_id":"github-repos","status":"success","output":"bob-work/demo\\nbob-work/plugins"}'
    printf '%s\n' '{"type":"message","timestamp":"2026-08-08T12:38:03Z","role":"assistant","isReasoning":false,"content":"Connecteur MCP GitHub opérationnel : 2 dépôts mockés via github_list_repos."}'
    printf '%s\n' '{"type":"result","timestamp":"2026-08-08T12:38:04Z","status":"success","stats":{"task_id":"e2e-github-connector-mcp","duration_ms":300,"tool_calls":1}}'
    exit 0
  fi

  if printf '%s' "$prompt" | grep -q 'USE_SLACK_CONNECTOR_MCP_E2E'; then
    call_integration_mcp 'bob-work-slack' 'slack_server.py' 'SLACK_BOT_TOKEN' 'e2e-slack-token' 'slack_list_channels' 'general'
    printf '%s\n' '{"type":"message","timestamp":"2026-08-08T12:38:10Z","role":"assistant","isReasoning":true,"content":"Initialisation du connecteur MCP Slack."}'
    printf '%s\n' '{"type":"tool_use","timestamp":"2026-08-08T12:38:11Z","tool_name":"use_mcp_tool","tool_id":"slack-channels","parameters":{"server":"bob-work-slack","tool":"slack_list_channels","arguments":{"limit":5}}}'
    printf '%s\n' '{"type":"tool_result","timestamp":"2026-08-08T12:38:12Z","tool_id":"slack-channels","status":"success","output":"general"}'
    printf '%s\n' '{"type":"message","timestamp":"2026-08-08T12:38:13Z","role":"assistant","isReasoning":false,"content":"Connecteur MCP Slack opérationnel : canal general listé via slack_list_channels."}'
    printf '%s\n' '{"type":"result","timestamp":"2026-08-08T12:38:14Z","status":"success","stats":{"task_id":"e2e-slack-connector-mcp","duration_ms":280,"tool_calls":1}}'
    exit 0
  fi

  if printf '%s' "$prompt" | grep -q 'USE_MONDAY_CONNECTOR_MCP_E2E'; then
    call_integration_mcp 'bob-work-monday' 'monday_server.py' 'MONDAY_API_TOKEN' 'e2e-monday-token' 'monday_list_boards' 'E2E Roadmap'
    printf '%s\n' '{"type":"message","timestamp":"2026-08-08T12:38:20Z","role":"assistant","isReasoning":true,"content":"Initialisation du connecteur MCP Monday.com."}'
    printf '%s\n' '{"type":"tool_use","timestamp":"2026-08-08T12:38:21Z","tool_name":"use_mcp_tool","tool_id":"monday-boards","parameters":{"server":"bob-work-monday","tool":"monday_list_boards","arguments":{"limit":5}}}'
    printf '%s\n' '{"type":"tool_result","timestamp":"2026-08-08T12:38:22Z","tool_id":"monday-boards","status":"success","output":"E2E Roadmap"}'
    printf '%s\n' '{"type":"message","timestamp":"2026-08-08T12:38:23Z","role":"assistant","isReasoning":false,"content":"Connecteur MCP Monday.com opérationnel : tableau E2E Roadmap via monday_list_boards."}'
    printf '%s\n' '{"type":"result","timestamp":"2026-08-08T12:38:24Z","status":"success","stats":{"task_id":"e2e-monday-connector-mcp","duration_ms":260,"tool_calls":1}}'
    exit 0
  fi

  if printf '%s' "$prompt" | grep -q 'USE_MICROSOFT_CONNECTOR_MCP_E2E'; then
