# OAuth integrations — required for one-click connect in Integrations
# Redirect URI registered with each provider: http://127.0.0.1:47823/oauth/callback
# Alternatively, fill src-tauri/resources/oauth/builtin_clients.json before release.

# GitHub: web authorize needs Client ID + secret. Without them, Bob Work falls
# back to the GitHub CLI device-flow public client (zero-config).
BOBWORK_OAUTH_GITHUB_CLIENT_ID=
BOBWORK_OAUTH_GITHUB_CLIENT_SECRET=

# Slack: PKCE public Client ID only (no secret, no UI paste). Required for
# one-click “Connecter avec Slack” → browser authorize. Create the app once from
# src-tauri/resources/oauth/slack_app_manifest.json (or api.slack.com Create from
# Manifest), then put Client ID here or in builtin_clients.json for release builds.
BOBWORK_OAUTH_SLACK_CLIENT_ID=
# Unused for Slack PKCE desktop redirects.
BOBWORK_OAUTH_SLACK_CLIENT_SECRET=

# Monday.com hosted MCP (mcp.monday.com): PKCE public client like ChatGPT.
# Bob Work registers a client via Dynamic Client Registration on first connect.
# Optional override if you already have a Monday MCP client ID:
BOBWORK_OAUTH_MONDAY_CLIENT_ID=
# Unused for Monday MCP PKCE (token_endpoint_auth_method=none).
BOBWORK_OAUTH_MONDAY_CLIENT_SECRET=

# Microsoft 365 (Outlook / Teams / Calendar / OneDrive): PKCE public client
# like ChatGPT — Client ID only, no Graph PowerShell device flow.
# Register per src-tauri/resources/oauth/microsoft_app_registration.json
# (loopback redirect + Allow public client flows).
BOBWORK_OAUTH_MICROSOFT_CLIENT_ID=
# Optional — unused for Microsoft PKCE public clients.
BOBWORK_OAUTH_MICROSOFT_CLIENT_SECRET=

# CTO Investissements plugin (optional connectors — T2 / T4)
# Free Finnhub token for US quote fallback when Stooq misses a symbol:
# FINNHUB_API_KEY=
# Optional remote market MCP URL (https) if you add one in the prompt / Integrations:
# CTO_REMOTE_MCP_URL=

# E2E — optional override for connection-tests-apis.e2e.ts (TMDB configuration URL)
# TMDB_API_KEY=
